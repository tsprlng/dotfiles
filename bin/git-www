#!/usr/bin/ruby
remote = `git config remote.origin.url`
if remote.match /^.*@([^:]+):(.*?)(\.git)?$/
  puts url = "http://#{$~[1]}/#{$~[2]}"
  #`chrome #{url}`
elsif remote.match /^[^@]*@(.*?)(\.git)?$/
  puts url = "http://#{$~[1]}"
  #`chrome #{url}`
else
  puts 'i am confused about ' + remote
end
