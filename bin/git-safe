#!/usr/bin/ruby

ActualGit = '/usr/bin/git'
OK = !! ENV['OK']

if %w[update rebase merge cherry-pick].any?{|cmd| ARGV.include?(cmd) } or %w[checkout -f].all?{|opt| ARGV.include?(opt) }
	if `pwd` != `git rev-parse --show-toplevel` and not OK
		$stderr.puts "Don't rebase or merge from a subdirectory (seems to be a worktree bug)."
		exit 4
	end
end

if ARGV.include? 'commit' and ARGV.any? {|a| a =~ /\A-[b-z]*a/ }
	state = `git status -s`.lines
	added = state.any?{|l| l =~ /\A[^\? ]/ }
	unadded = state.any?{|l| l =~ /\A.[^\? ]/ }
	if added and unadded and not OK
		$stderr.puts "Careful! You're using commit with -a when you've already staged some stuff."
		exit 4
	end
end

args = ARGV
args = %w[status -s] if args.empty?
exec(ActualGit, *args)
